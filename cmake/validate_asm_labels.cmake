if(NOT DEFINED PACK_DIR)
    message(FATAL_ERROR "validate_asm_labels.cmake requires -DPACK_DIR=<dir>")
endif()

# Cemu resolves labels across all of a pack's patch files, so dropping a definition from one file breaks a reference
# in another, and Cemu only reports it when the pack gets applied. Only patch_*.asm are loaded.
file(GLOB VAR_ASM_FILES "${PACK_DIR}/patch_*.asm")
list(LENGTH VAR_ASM_FILES VAR_FILE_COUNT)
if(VAR_FILE_COUNT EQUAL 0)
    message(FATAL_ERROR "No patch_*.asm files found under PACK_DIR='${PACK_DIR}' -- the check would pass vacuously")
endif()

set(VAR_DEFINED "")
set(VAR_REFERENCES "")

foreach(VAR_FILE ${VAR_ASM_FILES})
    file(READ "${VAR_FILE}" VAR_CONTENT)
    string(REGEX REPLACE "\r" "" VAR_CONTENT "${VAR_CONTENT}")
    string(REGEX REPLACE ";[^\n]*" "" VAR_CONTENT "${VAR_CONTENT}")
    string(REGEX REPLACE "[][\\]" "" VAR_CONTENT "${VAR_CONTENT}")
    string(REPLACE "\n" ";" VAR_LINES "${VAR_CONTENT}")
    get_filename_component(VAR_NAME "${VAR_FILE}" NAME)

    foreach(VAR_LINE ${VAR_LINES})
        string(STRIP "${VAR_LINE}" VAR_T)
        if(VAR_T MATCHES "^(0x[0-9A-Fa-f]+[ \t]*=[ \t]*)?([A-Za-z_][A-Za-z0-9_.]*)[ \t]*:")
            list(APPEND VAR_DEFINED "${CMAKE_MATCH_2}")
        elseif(VAR_T MATCHES "^([A-Za-z_][A-Za-z0-9_.]*)[ \t]*=")
            list(APPEND VAR_DEFINED "${CMAKE_MATCH_1}")
        endif()

        string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_.]*@(ha|h|l)" VAR_HITS "${VAR_T}")
        foreach(VAR_HIT ${VAR_HITS})
            string(REGEX REPLACE "@.*" "" VAR_SYM "${VAR_HIT}")
            list(APPEND VAR_REFERENCES "${VAR_SYM}|${VAR_NAME}")
        endforeach()
        if(VAR_T MATCHES "^(b|bl|ba|bla|beq|bne|blt|bgt|ble|bge|bdnz|bdz)[ \t]+([A-Za-z_][A-Za-z0-9_.]*)$")
            list(APPEND VAR_REFERENCES "${CMAKE_MATCH_2}|${VAR_NAME}")
        endif()
    endforeach()
endforeach()

list(REMOVE_DUPLICATES VAR_DEFINED)
list(REMOVE_DUPLICATES VAR_REFERENCES)
string(JOIN "|" VAR_DEFINED_JOINED ${VAR_DEFINED})
set(VAR_DEFINED_JOINED "|${VAR_DEFINED_JOINED}|")

set(VAR_PROBLEMS "")
foreach(VAR_REFERENCE ${VAR_REFERENCES})
    string(REPLACE "|" ";" VAR_PARTS "${VAR_REFERENCE}")
    list(GET VAR_PARTS 0 VAR_SYM)
    list(GET VAR_PARTS 1 VAR_NAME)
    if(VAR_SYM MATCHES "^import\\.")
        continue()
    endif()
    string(FIND "${VAR_DEFINED_JOINED}" "|${VAR_SYM}|" VAR_POS)
    if(VAR_POS EQUAL -1)
        list(APPEND VAR_PROBLEMS "${VAR_NAME}: '${VAR_SYM}' is not defined in any patch file of the pack")
    endif()
endforeach()

list(LENGTH VAR_PROBLEMS VAR_COUNT)
if(VAR_COUNT GREATER 0)
    string(REPLACE ";" "\n  " VAR_JOINED "${VAR_PROBLEMS}")
    message(FATAL_ERROR "Pack label check failed (${VAR_COUNT} problem(s)):\n  ${VAR_JOINED}\n")
endif()

message(STATUS "Pack label check: ${VAR_FILE_COUNT} patch file(s) resolve")
